// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator nexusPrisma {
  provider = "nexus-prisma"
}

model User {
  userId        String       @id @default(cuid())
  githubId      String       @unique
  libraries     Library[]
  favorites     Book[]
  stats         Stats?
  libraryInfo   LibraryInfo? @relation(fields: [libraryInfoId], references: [id])
  libraryInfoId String?
}

model Stats {
  readBooks       Int     @default(0)
  notReadBooks    Int     @default(0)
  readPages       Int     @default(0)
  totalPages      Int     @default(0)
  ownedLibraries  Int     @default(0)
  sharedLibraries Int     @default(0)
  genreRead       Genre[]
  userStats       User    @relation(fields: [statsUserId], references: [userId])
  statsUserId     String  @id @unique
}

model Genre {
  tag             Tag
  booksNum        Int
  userStats       Stats  @relation(fields: [userStatsUserId], references: [statsUserId])
  userStatsUserId String

  @@unique([userStatsUserId, tag])
}

model LibraryInfo {
  id               String   @id @default(cuid())
  library          Library?
  members          User[]
  prevelantTags    Tag[]    @default([])
  italianBooks     Int      @default(0)
  englishBooks     Int      @default(0)
  prevelantEdition Edition
}

model Library {
  id                String      @id @default(cuid())
  ownerId           String
  sharesId          String[]
  shared            Boolean
  name              String
  info              LibraryInfo @relation(fields: [infoId], references: [id])
  infoId            String      @unique
  booksCount        Int         @default(0)
  books             Book[]
  userLibrary       User?       @relation(fields: [userLibraryUserId], references: [userId])
  userLibraryUserId String?

  @@unique([userLibraryUserId, name])
}

model Book {
  id          Int             @id @default(autoincrement())
  title       String
  author      String          @default("")
  publisher   String          @default("")
  thumbnail   String?
  pages       Int?
  ISBN        String?
  description String          @default("")
  tags        Tag[]           @default([])
  rating      PersonalScore[]
  row         Int?
  position    Position?
  read        ReadCheck[]
  lang        String          @default("")
  edition     Edition[]       @default([])
  price       Float?
  buyLink     String?
  gifted      Boolean?        @default(false)
  library     Library?        @relation(fields: [libraryId], references: [id])
  libraryId   String?
  user        User?           @relation(fields: [userId], references: [userId])
  userId      String?
}

model ReadCheck {
  read   Boolean
  userId String
  book   Book    @relation(fields: [bookId], references: [id])
  bookId Int

  @@unique([userId, bookId])
}

model PersonalScore {
  rating Float
  userId String
  book   Book   @relation(fields: [bookId], references: [id])
  bookId Int

  @@unique([userId, bookId])
}

model Position {
  id              Int              @id @default(autoincrement())
  libraryPosition LibraryPosition?
  shelf           Int
  book            Book             @relation(fields: [bookId], references: [id])
  bookId          Int              @unique
}

model LibraryPosition {
  id            Int      @id @default(autoincrement())
  libraryName   String
  libraryNumber Int
  position      Position @relation(fields: [positionId], references: [id])
  positionId    Int      @unique
}

enum Tag {
  FANTASY
  CONTEMPORARY_LITERATURE
  ROMANCE
  DETECTIVE_BOOKS
  THRILLER
  HORROR
  TRUE_STORY
  PERSONAL_GROUTH
  HISTORICAL
}

enum Edition {
  HARDBACK
  PAPERBACK
}
